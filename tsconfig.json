{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"types": ["node"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"allowJs": true,
		"skipLibCheck": true,
		"noEmit": true,
		"incremental": true,
		"plugins": [{ "name": "next" }],
		"paths": {
			"@server/*": ["./src/server/*"],
			"@shared/*": ["./src/shared/*"],
			"@web/*": ["./src/web/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"next.config.ts",
		"vitest.config.ts",
		"src/**/*",
		"scripts/**/*",
		"tests/**/*",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
